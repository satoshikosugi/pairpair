{
  "name": "@pairpair/desktop",
  "version": "0.1.0",
  "description": "PairPair - Remote pair programming application",
  "author": "PairPair Contributors",
  "private": true,
  "files": [
    "out"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node ./scripts/ensure-electron-install.cjs && node ./scripts/ensure-native-input.cjs",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "prestart": "node ./scripts/ensure-electron-install.cjs && node ./scripts/ensure-native-input.cjs",
    "start": "electron-vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:prepare": "node ./scripts/prepare-package.cjs",
    "package": "node ./scripts/prepare-package.cjs && electron-builder --config electron-builder.yml --publish=never",
    "package:win": "node ./scripts/package-win.cjs",
    "package:mac": "node ./scripts/prepare-package.cjs --platform=darwin --arch=arm64 --native-target=aarch64-apple-darwin && electron-builder --config electron-builder.yml --mac dmg zip --arm64 --publish=never",
    "package:mac:x64": "node ./scripts/prepare-package.cjs --platform=darwin --arch=x64 --native-target=x86_64-apple-darwin && electron-builder --config electron-builder.yml --mac dmg zip --x64 --publish=never",
    "package:mac:arm64": "node ./scripts/prepare-package.cjs --platform=darwin --arch=arm64 --native-target=aarch64-apple-darwin && electron-builder --config electron-builder.yml --mac dmg zip --arm64 --publish=never"
  },
  "dependencies": {
    "@cloudflare/opaque-ts": "0.7.5",
    "@pairpair/native-input": "workspace:*",
    "@pairpair/shared": "workspace:*",
    "electron-log": "^4.4.8",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "zustand": "^4.5.2"
  }
}
